# 로컬은 application-local.yml 기본값을 쓰므로 비워 둬도 된다.
# prod 프로필에서 필요한 값
DB_URL=jdbc:postgresql://localhost:5432/kidly
DB_USERNAME=kidly
DB_PASSWORD=kidly

# JWT 서명 키 (PEM 파일 경로). prod에서만 필요하다. 로컬은 config/jwt의 개발용 키를 쓴다
# JWT_PUBLIC_KEY_LOCATION=file:/path/to/public.pem
# JWT_PRIVATE_KEY_LOCATION=file:/path/to/private.pem

# 운영 로그 파일 경로 (기본 ./logs)
LOG_PATH=./logs
