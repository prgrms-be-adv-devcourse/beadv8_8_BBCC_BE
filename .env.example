# 프로젝트 루트에 .env로 복사해 쓴다 (git 제외). 값은 따옴표로 감싸도 되고 안 감싸도 된다

# 로컬은 application-local.yml 기본값을 쓰므로 비워 둬도 된다.
# prod 프로필에서 필요한 값
DB_URL=jdbc:postgresql://localhost:5432/kidly
DB_USERNAME=kidly
DB_PASSWORD=kidly

# JWT 서명 키 (PEM 파일 경로). prod에서만 필요하다. 로컬은 config/jwt의 개발용 키를 쓴다
# JWT_PUBLIC_KEY_LOCATION=file:/path/to/public.pem
# JWT_PRIVATE_KEY_LOCATION=file:/path/to/private.pem

# 카카오 로그인 (카카오 개발자 콘솔). prod에서 필요하다
# KAKAO_CLIENT_ID=REST API 키
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://프론트도메인/oauth/kakao

# 운영 로그 파일 경로 (기본 ./logs)
LOG_PATH=./logs

# Logstash 주소 (기본 localhost:5000). 로컬은 docker compose의 Logstash를 쓰므로 비워 둬도 된다
# LOGSTASH_HOST=localhost
# LOGSTASH_PORT=5000

# ===== 결제 =====
# 토스페이먼츠 시크릿 키. 개발자센터의 테스트 키(test_sk_로 시작)를 쓰면 실제 결제가 되지 않는다
# TOSS_SECRET_KEY=test_sk_...

# 토스 paymentKey 암호화 키(Base64 32바이트). 로컬은 비워 두면 개발용 키를 쓴다. 운영은 반드시 넣는다
# 만들기: openssl rand -base64 32
# PAYMENT_KEY_ENCRYPTION_KEY=
