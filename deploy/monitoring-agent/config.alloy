// t3.large(앱 서버)의 수집기. 이 서버 k3s 의 namespace monitoring 에 Pod 하나로 뜬다(alloy.yaml, #1210)
// 앱 로그 · 앱 메트릭 · 호스트 · Pod 자원 지표를 t3.medium k3s(deploy/monitoring)로 보낸다
// 받는 곳은 medium 의 NodePort(Loki 31100, Prometheus 30090)다. 주소는 환경 변수 MONITORING_HOST(medium 사설 IP)
// 앱은 모두 k3s 에 뜬다(#1142). 로그 · 메트릭은 아래 discovery.kubernetes 로 Pod 를 찾아 모은다

// 앱 로그 공통 처리. 서버 콘솔은 ECS JSON 한 줄이다. 텍스트 줄은 JSON 이전 이미지가 남긴 것이다
loki.process "kidly_app" {
	// 텍스트 줄의 스택 트레이스 여러 줄을 로그 한 건으로 묶는다 (로그 줄은 날짜 또는 JSON 의 { 로 시작한다)
	stage.multiline {
		firstline     = "^(\\d{4}-\\d{2}-\\d{2} |\\{)"
		max_wait_time = "3s"
	}

	// 예: {"@timestamp":"...","log":{"level":"ERROR",...},...,"traceId":"...","memberId":"7"}
	// traceId 는 요청 안에서만, memberId 는 로그인한 요청 안에서만 있다
	stage.json {
		expressions = {
			level    = "log.level",
			traceId  = "",
			memberId = "",
		}
	}

	// 예: 2026-10-16 17:33:04.385 ERROR [traceId] ... — 날짜로 시작하는 텍스트 줄에만 맞는다
	stage.regex {
		expression = "^\\d{4}-\\d{2}-\\d{2} \\S+\\s+(?P<level>[A-Z]+) "
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	// traceId · memberId 는 값 종류가 끝이 없어 라벨이 아니라 구조화 메타데이터로 둔다. {env="dev"} | traceId="..." 로 거른다
	stage.structured_metadata {
		values = {
			traceId  = "",
			memberId = "",
		}
	}

	forward_to = [loki.write.medium.receiver]
}

loki.write "medium" {
	endpoint {
		url = string.format("http://%s:31100/loki/api/v1/push", sys.env("MONITORING_HOST"))
	}
}

// k3s 에 뜨는 서비스(namespace kidly-<환경>, deploy/k3s, #1142)는 이 서버의 단독 k3s API 로 Pod 를 찾는다
// Pod 의 ServiceAccount(alloy.yaml 의 kidly-alloy, Pod 조회 · 로그 읽기 · kubelet 지표만)로 k3s API 에 붙는다. 호스트 네트워크라 Pod IP 에 바로 닿는다
// Pod 라벨 kidly/job(deploy/k3s/k3s.py 가 붙임)을 job · service_name 으로 쓴다(kidly-<서비스> · kidly-kafka)
discovery.kubernetes "kidly_pods" {
	role = "pod"

	namespaces {
		names = ["kidly-dev"]
	}
}

discovery.relabel "kidly_pods" {
	targets = discovery.kubernetes.kidly_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_phase"]
		regex         = "Running|Succeeded|Failed"
		action        = "keep"
	}

	// kidly/job 라벨이 없는 Pod(이 라벨 전에 뜬 Pod)는 kidly-<app> 으로 둔다. 모니터링 배포가 앱 배포보다 먼저 끝나도 끊기지 않게 한다
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		regex         = "(.+)"
		target_label  = "__kidly_job"
		replacement   = "kidly-$1"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_kidly_job"]
		regex         = "(kidly-.+)"
		target_label  = "__kidly_job"
	}

	rule {
		source_labels = ["__kidly_job"]
		regex         = "kidly-.+"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "kidly-(.+)"
		target_label  = "env"
	}
}

// 메트릭은 Pod 마다 따로 긁는다(NodePort 로 긁으면 매번 다른 Pod 에 닿는다). instance 는 Pod 이름이다
discovery.relabel "kidly_pod_metrics" {
	targets = discovery.relabel.kidly_pods.output

	rule {
		source_labels = ["__meta_kubernetes_pod_phase"]
		regex         = "Running"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "http"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__kidly_job"]
		target_label  = "job"
	}
}

// 종료된 Job Pod 의 마지막 로그도 모은다. 로그에는 service_name(kidly-<서비스>)을 붙인다. instance(Pod) · job 은 loki.source.kubernetes 가 붙인다
discovery.relabel "kidly_pod_logs" {
	targets = discovery.relabel.kidly_pods.output

	rule {
		source_labels = ["__kidly_job"]
		target_label  = "service_name"
	}
}

loki.source.kubernetes "kidly_pods" {
	targets    = discovery.relabel.kidly_pod_logs.output
	forward_to = [loki.process.kidly_app.receiver]
}

// 앱 서비스 Pod. kafka-exporter(kidly-kafka)는 아래 kidly_kafka 가 지표를 걸러 긁는다
// Redis(kidly-redis)는 /actuator/prometheus 가 없어 지표를 긁지 않는다. 로그는 위 kidly_pod_logs 가 모은다
discovery.relabel "kidly_app_pods" {
	targets = discovery.relabel.kidly_pod_metrics.output

	rule {
		source_labels = ["job"]
		regex         = "kidly-kafka|kidly-redis"
		action        = "drop"
	}
}

discovery.relabel "kidly_kafka_pods" {
	targets = discovery.relabel.kidly_pod_metrics.output

	rule {
		source_labels = ["job"]
		regex         = "kidly-kafka"
		action        = "keep"
	}
}

// job 은 위에서 Pod 마다 붙였다. job_name 은 job 이 없을 때만 쓰인다
prometheus.scrape "kidly_pods" {
	job_name        = "kidly-k3s"
	targets         = discovery.relabel.kidly_app_pods.output
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.medium.receiver]
}

// 호스트(EC2) 자원 사용량. Alloy 내장 node exporter 로 모아 Prometheus 에 remote write 한다
// 호스트 경로는 alloy.yaml 이 읽기 전용으로 마운트한다
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/rootfs"
}

// 서비스 메트릭과 같은 15초 간격
prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.remote_write.medium.receiver]
	scrape_interval = "15s"
}

// k3s Pod 컨테이너 CPU · 메모리. kubelet 이 내장한 cAdvisor 에서 읽는다
// 토큰은 Pod 의 ServiceAccount 토큰이다(alloy.yaml 의 kidly-alloy 에 nodes/metrics get 을 준다). 쿠버네티스가 갱신하고 긁을 때마다 파일을 다시 읽는다
// instance 는 호스트 지표와 같은 호스트 이름이라 Kidly 서버 대시보드의 서버 선택으로 함께 거른다
prometheus.scrape "k3s_cadvisor" {
	job_name        = "integrations/kubelet-cadvisor"
	targets         = [{"__address__" = "127.0.0.1:10250", "instance" = constants.hostname}]
	scheme          = "https"
	metrics_path    = "/metrics/cadvisor"
	scrape_interval = "15s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	// kubelet 은 자체 서명 인증서를 쓴다. 이 서버 안(127.0.0.1)에서만 붙는다
	tls_config {
		insecure_skip_verify = true
	}

	forward_to = [prometheus.relabel.k3s_cadvisor.receiver]
}

// 시계열을 줄인다: CPU · 메모리 · 메모리 상한만, 컨테이너 줄만(Pod 합계 줄 container="" · pause 는 뺀다), 라벨은 namespace · pod · container 만
prometheus.relabel "k3s_cadvisor" {
	forward_to = [prometheus.remote_write.medium.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes)"
		action        = "keep"
	}

	rule {
		source_labels = ["container"]
		regex         = "|POD"
		action        = "drop"
	}

	// 재시작마다 바뀌는 cgroup 경로(id) · 이미지 · containerd 이름은 뺀다
	rule {
		regex  = "id|image|name"
		action = "labeldrop"
	}
}

prometheus.remote_write "medium" {
	endpoint {
		url = string.format("http://%s:30090/api/v1/write", sys.env("MONITORING_HOST"))
	}
}

// Self-observation shares remote write; inventory on medium detects a complete delivery outage.
prometheus.scrape "alloy_self" {
    targets = [{"__address__" = "127.0.0.1:12345", "collector" = "app"}]
    job_name = "kidly-alloy"
    scrape_interval = "15s"
    forward_to = [prometheus.relabel.alloy_health.receiver]
}

prometheus.relabel "alloy_health" {
    forward_to = [prometheus.remote_write.medium.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|prometheus_remote_storage_(samples_pending|queue_highest_sent_timestamp_seconds|samples_failed_total|samples_dropped_total)|loki_write_(batch_retries_total|dropped_entries_total)"
        action = "keep"
    }
}

prometheus.scrape "kidly_kafka" {
    job_name = "kidly-kafka"
    targets = discovery.relabel.kidly_kafka_pods.output
    scrape_interval = "30s"
    forward_to = [prometheus.relabel.kafka_metrics.receiver]
}

prometheus.relabel "kafka_metrics" {
    forward_to = [prometheus.remote_write.medium.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|kafka_brokers|kafka_consumergroup_(lag|current_offset)|kafka_topic_partition_current_offset"
        action = "keep"
    }
}
