	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.medium.receiver]
}

// 추천 서비스(apps/recommend-service). 검색 서비스와 같은 이유로 job 을 나눈다
// 추천 서비스가 켜진 환경만 앱 배포가 targets/recommend/<환경>.yml 로 써 둔다
discovery.file "kidly_recommend" {
