// 주문 서비스(apps/order-service). 검색 서비스와 같은 이유로 job 을 나눈다
// 주문 서비스가 켜진 환경만 앱 배포가 targets/order/<환경>.yml 로 써 둔다(deploy/environment-state.py)
discovery.file "kidly_order" {
	files = ["/etc/alloy/targets/order/*.yml"]
}

prometheus.scrape "kidly_order" {
	job_name        = "kidly-order"
	targets         = discovery.file.kidly_order.targets
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.medium.receiver]
}

// 커뮤니티 서비스(apps/community-service). 검색 서비스와 같은 이유로 job 을 나눈다
// 커뮤니티 서비스가 켜진 환경만 앱 배포가 targets/community/<환경>.yml 로 써 둔다(deploy/environment-state.py)
discovery.file "kidly_community" {
	files = ["/etc/alloy/targets/community/*.yml"]
}

prometheus.scrape "kidly_community" {
	job_name        = "kidly-community"
	targets         = discovery.file.kidly_community.targets
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.medium.receiver]
}

// 호스트(EC2)와 컨테이너별 자원 사용량. 새 컨테이너 없이 Alloy 내장 exporter 로 모아 Prometheus 에 remote write 한다
// 호스트 경로는 docker-compose.yml 이 읽기 전용으로 마운트한다
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	rootfs_path = "/rootfs"
}

// 컨테이너는 name 라벨(dev-app-1 처럼 compose 프로젝트가 앞에 붙은 컨테이너 이름)로 구분한다. docker 라벨 · 환경 변수는 가져오지 않는다
prometheus.exporter.cadvisor "containers" {
	docker_only            = true
	store_container_labels = false
}

// 앱 메트릭(위 prometheus.scrape "kidly")과 같은 15초 간격
prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.remote_write.medium.receiver]
	scrape_interval = "15s"
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	forward_to      = [prometheus.remote_write.medium.receiver]
	scrape_interval = "15s"
}

prometheus.remote_write "medium" {
	endpoint {
		url = string.format("http://%s:30090/api/v1/write", sys.env("MONITORING_HOST"))
	}
}

// Self-observation shares remote write; inventory on medium detects a complete delivery outage.
prometheus.scrape "alloy_self" {
    targets = [{"__address__" = "127.0.0.1:12345", "collector" = "app"}]
    job_name = "kidly-alloy"
    scrape_interval = "15s"
    forward_to = [prometheus.relabel.alloy_health.receiver]
}

prometheus.relabel "alloy_health" {
    forward_to = [prometheus.remote_write.medium.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|prometheus_remote_storage_(samples_pending|queue_highest_sent_timestamp_seconds|samples_failed_total|samples_dropped_total)|loki_write_(batch_retries_total|dropped_entries_total)"
        action = "keep"
    }
}

// Broker metrics use /metrics, not the application actuator path.
discovery.file "kidly_kafka" {
    files = ["/etc/alloy/targets/kafka/*.yml"]
}
prometheus.scrape "kidly_kafka" {
    job_name = "kidly-kafka"
    targets = discovery.file.kidly_kafka.targets
    scrape_interval = "30s"
    forward_to = [prometheus.relabel.kafka_metrics.receiver]
}

prometheus.relabel "kafka_metrics" {
    forward_to = [prometheus.remote_write.medium.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|kafka_brokers|kafka_consumergroup_(lag|current_offset)|kafka_topic_partition_current_offset"
        action = "keep"
    }
}
