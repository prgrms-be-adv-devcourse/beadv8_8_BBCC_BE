# Kidly API 리버스 프록시. install.sh 가 __DOMAIN__ 을 실제 도메인으로, __MONITORING_HOST__ 를 모니터링 서버(t3.medium) 사설 IP 로 바꿔
# /etc/nginx/conf.d/kidly.conf 로 설치한다.

# 아래 server 블록들이 함께 쓰는 설정 (인증서 하나에 api · dev-api · grafana 세 이름이 들어 있다)
ssl_certificate     /etc/letsencrypt/live/kidly/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/kidly/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:SSL:10m;

client_max_body_size 10m;

# location 에 proxy_set_header 를 하나라도 추가하면 여기 것이 모두 상속되지 않는다
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;

# 모르는 호스트(IP 로 직접 접속 등)는 응답 없이 끊는다
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

# HTTP: 인증서 발급·갱신용 경로만 열고 나머지는 https 로 보낸다
server {
    listen 80;
    server_name api.__DOMAIN__ dev-api.__DOMAIN__ grafana.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 운영 앱
server {
    listen 443 ssl;
    http2 on;
    server_name api.__DOMAIN__;

    # actuator 는 서버 안(Alloy)에서만 쓴다. 외부에는 헬스체크만 연다
    location /actuator {
        return 404;
    }

    location = /actuator/health {
        proxy_pass http://127.0.0.1:8080;
    }

    # Gateway(#638)가 토큰 검증 · CORS 를 하고 운영 앱으로 넘긴다. /actuator/health 는 위에서 앱을 그대로 본다
    location / {
        proxy_pass http://127.0.0.1:8084;
    }
}

# 개발 앱
server {
    listen 443 ssl;
    http2 on;
    server_name dev-api.__DOMAIN__;

    # actuator 는 서버 안(Alloy)에서만 쓴다. 외부에는 헬스체크만 연다
    location /actuator {
        return 404;
    }

    location = /actuator/health {
        proxy_pass http://127.0.0.1:8081;
    }

    # Gateway(#608)가 토큰 검증 · CORS 를 하고 개발 앱으로 넘긴다. /actuator/health 는 위에서 앱을 그대로 본다
    location / {
        proxy_pass http://127.0.0.1:8083;
    }
}

# 모니터링 (deploy/monitoring). Grafana 가 로그인을 받는다
# Grafana 는 t3.medium k3s 에 있다. 그 노드의 Traefik(80)이 Host 헤더(위 공통 설정이 넘긴다)로 Grafana Ingress 를 고른다
server {
    listen 443 ssl;
    http2 on;
    server_name grafana.__DOMAIN__;

    location / {
        proxy_pass http://__MONITORING_HOST__;
    }
}
