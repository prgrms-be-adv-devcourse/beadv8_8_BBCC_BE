# Kidly API 리버스 프록시. install.sh 가 __DOMAIN__ 을 실제 도메인으로 바꿔
# /etc/nginx/conf.d/kidly.conf 로 설치한다.

# 아래 server 블록들이 함께 쓰는 설정 (인증서 하나에 api · dev-api 두 이름이 들어 있다)
ssl_certificate     /etc/letsencrypt/live/kidly/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/kidly/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:SSL:10m;

client_max_body_size 10m;

# location 에 proxy_set_header 를 하나라도 추가하면 여기 것이 모두 상속되지 않는다
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;

# 모르는 호스트(IP 로 직접 접속 등)는 응답 없이 끊는다
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

# HTTP: 인증서 발급·갱신용 경로만 열고 나머지는 https 로 보낸다
server {
    listen 80;
    server_name api.__DOMAIN__ dev-api.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 운영 앱
server {
    listen 443 ssl;
    http2 on;
    server_name api.__DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}

# 개발 앱
server {
    listen 443 ssl;
    http2 on;
    server_name dev-api.__DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:8081;
    }
}
