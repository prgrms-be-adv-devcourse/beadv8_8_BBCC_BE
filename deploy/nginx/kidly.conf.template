# Kidly API 리버스 프록시. deploy.sh 가 __DOMAIN__ 을 실제 도메인으로, __MONITORING_HOST__ 를 모니터링 서버(t3.medium) 사설 IP 로 바꿔
# k3s ConfigMap 으로 만들고, nginx Pod(nginx.yaml)가 /etc/nginx/conf.d/kidly.conf 로 읽는다(#1309)
# Pod 는 호스트 네트워크를 쓰므로 127.0.0.1 은 이 서버(t3.large)다

# 아래 server 블록들이 함께 쓰는 설정 (인증서 하나에 api · grafana 두 이름이 들어 있다)
ssl_certificate     /etc/letsencrypt/live/kidly/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/kidly/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:SSL:10m;

client_max_body_size 10m;

# location 에 proxy_set_header 를 하나라도 추가하면 여기 것이 모두 상속되지 않는다
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;
# 공개 요청이 내부 트레이스와 샘플링 결정을 지정하지 못하게 한다.
# OTel Java Agent 는 Netty 서버 단계에서 이 헤더를 먼저 읽으므로 Gateway 필터에서 지우면 늦다(deploy/tracing-trial).
proxy_set_header traceparent "";
proxy_set_header tracestate  "";
proxy_set_header baggage     "";

# 모르는 호스트(IP 로 직접 접속 등)는 응답 없이 끊는다
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

# HTTP: 인증서 발급·갱신용 경로만 열고 나머지는 https 로 보낸다
server {
    listen 80;
    server_name api.__DOMAIN__ grafana.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 앱. dev-api 에서 api 로 옮겼다(#1335). Gateway 는 이 서버의 단독 k3s 에 뜨고 NodePort 30200 으로 닿는다(deploy/k3s, #1142)
server {
    listen 443 ssl;
    http2 on;
    server_name api.__DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:30200;
    }
}

# 모니터링 (deploy/monitoring). Grafana 가 로그인을 받는다
# Grafana 는 t3.medium k3s 에 있다. 그 노드의 Traefik(80)이 Host 헤더(위 공통 설정이 넘긴다)로 Grafana Ingress 를 고른다
server {
    listen 443 ssl;
    http2 on;
    server_name grafana.__DOMAIN__;

    location / {
        proxy_pass http://__MONITORING_HOST__;
    }
}
