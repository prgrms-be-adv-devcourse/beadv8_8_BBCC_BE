# 비밀 값은 넣지 않는다. 비밀은 배포 때 GitHub Environment Secret 에서 이 파일 뒤에 붙는다
# (DB_PASSWORD(=POSTGRES_PASSWORD), KAKAO_CLIENT_SECRET, TOSS_SECRET_KEY, PAYMENT_KEY_ENCRYPTION_KEY, MAIL_PASSWORD(선택), KIDLY_ADMIN_BOOTSTRAP_PASSWORD(선택). JWT 키는 jwt/ 에 파일로)
# DB_PASSWORD 를 바꾸면 DB 에서도 ALTER USER 로 바꿔야 한다 (POSTGRES_PASSWORD 는 볼륨을 처음 만들 때만 쓰인다)
# 설정은 prod 프로필을 dev 값으로 쓰고, dev 프로필은 초기 데이터와 테스트 토큰 API만 켠다

SPRING_PROFILES_ACTIVE=prod,dev
TZ=Asia/Seoul

# postgres 는 compose 서비스 이름이다. localhost 가 아니다
DB_URL=jdbc:postgresql://postgres:5432/kidly
DB_USERNAME=kidly
POSTGRES_DB=kidly
POSTGRES_USER=kidly

# 서버의 jwt/ 가 컨테이너 /app/jwt 로 마운트된다
JWT_PUBLIC_KEY_LOCATION=file:/app/jwt/public.pem
JWT_PRIVATE_KEY_LOCATION=file:/app/jwt/private.pem

# 서버의 logs/ 가 컨테이너 /app/logs 로 마운트된다
LOG_PATH=/app/logs

# 카카오 REST API 키. 프론트에도 있는 공개 값이다
KAKAO_CLIENT_ID=ed51f791136691f72eb3b0e85272b98c
KAKAO_REDIRECT_URI=https://dev.kidly.kro.kr/oauth/kakao/callback

# 로컬 프론트(5173)가 dev 서버 API 를 바로 붙어 보게 localhost 도 허용한다
CORS_ALLOWED_ORIGINS=https://dev.kidly.kro.kr,http://localhost:5173

APP_PORT=8081

# DB 를 서버 127.0.0.1 에만 연다. SSH 터널로 접속한다 (dev 5433 · prod 5434)
DB_PORT=5433

# 상품 이미지 S3 객체 key의 환경 경로 (dev/products/...)
PRODUCT_IMAGE_KEY_PREFIX=dev

# 알림 도메인 메일 발송 계정. 앱 비밀번호 MAIL_PASSWORD 는 Secret 에서 붙는다 (없으면 보내지 않고 로그만)
MAIL_USERNAME=programmers.bbcc.official@gmail.com

# 알림 메일 본문의 사이트 주소
NOTIFICATION_SITE_URL=https://dev.kidly.kro.kr

# 검색(search-service) · Gateway · 자녀 프로필(childprofile-service)을 띄운다 (docker-compose.yml 의 profile search · gateway · childprofile). app 에 자녀 API 가 없어 prod 도 childprofile 을 켜야 한다
# Elasticsearch 는 compose 에 없다. 이 값에 search 가 있으면 deploy 워크플로가 t3.medium k3s(deploy/search)에 먼저 올린다
COMPOSE_PROFILES=search,gateway,childprofile,recommend,settlement,member,payment

# 검색 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다
# 밖에 열 때는 nginx 가 아니라 Gateway 라우트로 연다(서비스는 X-Member-* 헤더를 그대로 믿어서 nginx 가 바로 넘기면 위조할 수 있다)
SEARCH_PORT=8082

# 검색 색인 이름 앞의 환경 이름 (dev-products · dev-sellers)
SEARCH_INDEX_PREFIX=dev

# Gateway 를 서버 127.0.0.1 에만 연다. nginx 의 dev 블록이 여기로 넘긴다
GATEWAY_PORT=8083

# Gateway 가 상품 목록(GET /api/v1/products)을 넘길 곳(#526). 없으면 app 이 받는다(prod)
KIDLY_SEARCH_URI=http://search-service:8080

# 결제가 정산 지급 요청(settlement.payout-requested)을 Kafka(kidly.settlement.events)로 받는다(#607 · #612). 기본은 Spring 이벤트
# 정산이 Kafka로 보내는 코드(#612)가 배포된 환경에서만 켠다. prod 는 main 에 #612 가 들어간 뒤에 켠다
PAYMENT_KAFKA_SETTLEMENT_CONSUMER_ENABLED=true

# 자녀 프로필 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. prod 는 .env.prod 의 8088 이다(dev 와 같은 서버. 8086 · 8087 은 추천 서비스 몫으로 비워 둔다)
CHILDPROFILE_PORT=8085

# 추천 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. prod 는 .env.prod 의 8086
RECOMMEND_PORT=8087

# 관리자가 한 명도 없을 때 이 이메일과 Secret KIDLY_ADMIN_BOOTSTRAP_PASSWORD 로 첫 관리자를 만든다. 관리자가 생긴 뒤에는 무시된다
KIDLY_ADMIN_BOOTSTRAP_EMAIL=admin@kidly.kro.kr

# 정산 서비스. Gateway가 정산 API(/api/v1/seller/settlement* · /api/v1/admin/settlement*)를 서비스로 보낸다. 값을 지우면 kidly-app이 받는다
KIDLY_SETTLEMENT_URI=http://settlement-service:8080
# 정산 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. prod 에서 켤 때는 .env.prod 에 따로 둔다(8086 · 8088 은 이미 쓰고 있다)
SETTLEMENT_PORT=8089

# app 에 회원 · 인증 · 판매자 API 가 없어 회원 API 를 쓰는 환경은 모두 켠다. 이 값과 profile member 를 함께 지우면 안 된다
KIDLY_MEMBER_URI=http://member-service:8080
# 회원 서비스를 서버 127.0.0.1 에만 열어 Alloy 가 수집한다
MEMBER_PORT=8090

# 결제 서비스. Gateway가 결제 API(/api/v1/payments · /api/v1/wallets · /api/v1/webhooks/toss · /api/v1/admin/payments · /api/v1/admin/wallets)를 서비스로 보낸다. 값을 지우면 kidly-app이 받는다
KIDLY_PAYMENT_URI=http://payment-service:8080
# 결제 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. 8090 · 8091 은 회원 서비스(dev · prod)가 쓴다
PAYMENT_PORT=8092
