# 비밀 값은 넣지 않는다. 비밀은 배포 때 GitHub Environment Secret 에서 이 파일 뒤에 붙는다
# (DB_PASSWORD, KAKAO_CLIENT_SECRET, PORTONE_API_SECRET, IDENTITY_KEY_SECRET, TOSS_SECRET_KEY, PAYMENT_KEY_ENCRYPTION_KEY, MAIL_PASSWORD(선택), KIDLY_ADMIN_BOOTSTRAP_PASSWORD(선택). JWT 키는 jwt/ 에 파일로)
# DB_PASSWORD 는 t3.medium PostgreSQL 의 앱 계정(kidly_<환경>) 비밀번호다. 배포 때 postgres job 이 계정에 맞춘다

SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Seoul

# DB 는 t3.medium k3s 의 PostgreSQL(deploy/postgres) database kidly_dev. DB_URL(사설 IP)은 deploy 워크플로가 붙인다
DB_USERNAME=kidly_dev

# 서버의 jwt/ 가 컨테이너 /app/jwt 로 마운트된다
JWT_PUBLIC_KEY_LOCATION=file:/app/jwt/public.pem
JWT_PRIVATE_KEY_LOCATION=file:/app/jwt/private.pem

# 서버의 logs/ 가 컨테이너 /app/logs 로 마운트된다
LOG_PATH=/app/logs

# 카카오 REST API 키. 프론트에도 있는 공개 값이다
KAKAO_CLIENT_ID=ed51f791136691f72eb3b0e85272b98c
KAKAO_REDIRECT_URI=https://dev.kidly.kro.kr/oauth/kakao/callback

# 로컬 프론트(5173)가 dev 서버 API 를 바로 붙어 보게 localhost 도 허용한다
CORS_ALLOWED_ORIGINS=https://dev.kidly.kro.kr,http://localhost:5173


# t3.medium k3s 의 Kafka 브로커(Redpanda) NodePort. dev 30092 · prod 30093. deploy 워크플로가 사설 IP 와 합쳐 KAFKA_BOOTSTRAP_SERVERS 를 붙인다
KAFKA_NODE_PORT=30092

# 상품 이미지 S3 객체 key의 환경 경로 (dev/products/...)
PRODUCT_IMAGE_KEY_PREFIX=dev

# 알림 도메인 메일 발송 계정. 앱 비밀번호 MAIL_PASSWORD 는 Secret 에서 붙는다 (없으면 보내지 않고 로그만)
MAIL_USERNAME=programmers.bbcc.official@gmail.com

# 알림 메일 본문의 사이트 주소
NOTIFICATION_SITE_URL=https://dev.kidly.kro.kr

# 검색(search-service) · Gateway를 띄운다 (docker-compose.yml 의 profile search · gateway). 자녀 API는 회원 서비스가 제공한다
# Elasticsearch 는 compose 에 없다. 이 값에 search 가 있으면 deploy 워크플로가 t3.medium k3s(deploy/search)에 먼저 올린다
# 추천은 compose 가 아니라 t3.large 의 k3s 에 뜬다(아래 RECOMMEND_NODE_PORT, #1028)
COMPOSE_PROFILES=search,gateway,settlement,member,payment,product,order,community,notification,kafka-monitoring

# 검색 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다
# 밖에 열 때는 nginx 가 아니라 Gateway 라우트로 연다(서비스는 X-Member-* 헤더를 그대로 믿어서 nginx 가 바로 넘기면 위조할 수 있다)
SEARCH_PORT=8082

# 검색 색인 이름 앞의 환경 이름 (dev-products · dev-sellers)
SEARCH_INDEX_PREFIX=dev

# Gateway 를 서버 127.0.0.1 에만 연다. nginx 의 dev 블록이 여기로 넘긴다
GATEWAY_PORT=8083

# Gateway 가 상품 목록(GET /api/v1/products)을 넘길 곳(#526). 없으면 app 이 받는다(prod)
KIDLY_SEARCH_URI=http://search-service:8080


# 추천 서비스는 k3s(namespace recommend-dev, deploy/recommend)에 뜬다. 이 키가 있으면 deploy 워크플로의 recommend job 이 올린다(#1028)
# NodePort 는 보안 그룹에서 밖으로 열지 않는다. Gateway 는 같은 서버의 NodePort 로 붙는다. 메트릭 · 로그는 monitoring-agent Alloy 가 Pod 에서 모은다
RECOMMEND_NODE_PORT=30187
KIDLY_RECOMMEND_URI=http://host.docker.internal:30187

# 관리자가 한 명도 없을 때 이 이메일과 Secret KIDLY_ADMIN_BOOTSTRAP_PASSWORD 로 첫 관리자를 만든다. 관리자가 생긴 뒤에는 무시된다
KIDLY_ADMIN_BOOTSTRAP_EMAIL=admin@kidly.kro.kr

# 정산 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. prod 는 .env.prod 의 8095
SETTLEMENT_PORT=8089

# app 에 회원 · 인증 · 판매자 API 가 없어 회원 API 를 쓰는 환경은 모두 켠다. 이 값과 profile member 를 함께 지우면 안 된다
KIDLY_MEMBER_URI=http://member-service:8080
# 회원 서비스를 서버 127.0.0.1 에만 열어 Alloy 가 수집한다
MEMBER_PORT=8090

# 결제 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. prod 는 .env.prod 의 8093 이다(dev 와 같은 서버. 8090 · 8091 은 회원 서비스)
PAYMENT_PORT=8092

# 상품 API(공개 · 판매자 · 관리자)를 받을 곳(#791). profile product도 켜져 있어야 한다. 줄을 지우면 app이 상품 API를 받는다
KIDLY_PRODUCT_URI=http://product-service:8080

# 상품 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, prod와 다른 번호여야 한다
PRODUCT_PORT=8096

# 서버 메모리가 바닥나면 커널이 이 값을 더한 점수로 죽일 프로세스를 고른다. dev 컨테이너가 prod 보다 먼저 죽게 한다(prod 는 기본값 0, docker-compose.yml 의 app 주석)
OOM_SCORE_ADJ=500

# 주문 · 장바구니 · 배송 · 조르기 · 주문 관리자 API를 받을 곳(#826). profile order도 켜져 있어야 한다
KIDLY_ORDER_URI=http://order-service:8080

# 주문 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, prod(8101)와 다른 번호여야 한다
ORDER_PORT=8100

# 주문 운영 조회 MCP 창구(#925, 읽기 전용 · 관리자만) · 멈춘 주문 AI 진단 메모(#926). dev 에서만 켠다(#1041).
# AI 키는 deploy 워크플로가 붙이는 GROQ_API_KEY 를 쓴다(docker-compose.yml). 키가 없으면 AI 진단만 꺼진다. 하루 상한은 기본값(200) 그대로
ORDER_MCP_ENABLED=true
ORDER_AI_ENABLED=true

# 리뷰 · 찜 · 커뮤니티 관리자 API를 받을 곳(#827). profile community도 켜져 있어야 한다
KIDLY_COMMUNITY_URI=http://community-service:8080

# 커뮤니티 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, prod(8103)와 다른 번호여야 한다
COMMUNITY_PORT=8102

# 커뮤니티 운영 조회 MCP 창구(#1005, 읽기 전용 · 관리자만). dev 에서만 켠다
COMMUNITY_MCP_ENABLED=true

# 쓰이지 않는 리뷰 사진 정리(#1036). 서버 역할의 S3 삭제(DeleteObject) · 목록(ListBucket) 권한을 확인한 뒤 true 로 바꾼다
COMMUNITY_REVIEW_IMAGE_CLEANUP_ENABLED=false

# 알림 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, prod(8099)와 다른 번호여야 한다
NOTIFICATION_PORT=8098

# Kafka exporter 전용 loopback 포트
KAFKA_EXPORTER_PORT=9308
