# 비밀 값은 넣지 않는다. 비밀은 배포 때 GitHub Environment Secret 에서 이 파일 뒤에 붙는다
# (DB_PASSWORD, KAKAO_CLIENT_SECRET, PORTONE_API_SECRET, IDENTITY_KEY_SECRET, TOSS_SECRET_KEY, PAYMENT_KEY_ENCRYPTION_KEY, MAIL_PASSWORD(선택), KIDLY_ADMIN_BOOTSTRAP_PASSWORD(선택). JWT 키는 jwt/ 에 파일로)
# DB_PASSWORD 는 t3.medium PostgreSQL 의 앱 계정(kidly_<환경>) 비밀번호다. 배포 때 postgres job 이 계정에 맞춘다

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# DB 는 t3.medium k3s 의 PostgreSQL(deploy/postgres) database kidly_prod. DB_URL(사설 IP)은 deploy 워크플로가 붙인다
DB_USERNAME=kidly_prod

# 서버의 jwt/ 가 컨테이너 /app/jwt 로 마운트된다
JWT_PUBLIC_KEY_LOCATION=file:/app/jwt/public.pem
JWT_PRIVATE_KEY_LOCATION=file:/app/jwt/private.pem

# 서버의 logs/ 가 컨테이너 /app/logs 로 마운트된다
LOG_PATH=/app/logs

# 카카오 REST API 키. 프론트에도 있는 공개 값이다
KAKAO_CLIENT_ID=ed51f791136691f72eb3b0e85272b98c
KAKAO_REDIRECT_URI=https://kidly.kro.kr/oauth/kakao/callback

CORS_ALLOWED_ORIGINS=https://kidly.kro.kr


# t3.medium k3s 의 Kafka 브로커(Redpanda) NodePort. dev 30092 · prod 30093. deploy 워크플로가 사설 IP 와 합쳐 KAFKA_BOOTSTRAP_SERVERS 를 붙인다
KAFKA_NODE_PORT=30093

# 상품 이미지 S3 객체 key의 환경 경로 (prod/products/...)
PRODUCT_IMAGE_KEY_PREFIX=prod

# 알림 도메인 메일 발송 계정. 앱 비밀번호 MAIL_PASSWORD 는 Secret 에서 붙는다 (없으면 보내지 않고 로그만)
MAIL_USERNAME=programmers.bbcc.official@gmail.com

# 알림 메일 본문의 사이트 주소
NOTIFICATION_SITE_URL=https://kidly.kro.kr

# 검색(search-service) · Gateway · 추천 · 회원 · 결제 · 정산 · 상품 서비스를 띄운다 (docker-compose.yml 의 profile search · gateway · recommend · member · payment · settlement · product)
# Elasticsearch 는 compose 에 없다. 이 값에 search 가 있으면 deploy 워크플로가 t3.medium k3s(deploy/search)에 먼저 올린다. dev 와 같은 ES 를 색인 이름(SEARCH_INDEX_PREFIX)으로 나눠 쓴다
COMPOSE_PROFILES=search,gateway,recommend,member,payment,settlement,product,notification,order,community,chatbot,kafka-monitoring

# 검색 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다
# dev 도 8082 지만 dev · prod 는 compose 프로젝트가 달라도 서버 포트를 함께 쓴다. prod 에서 비어 있는 8094 를 쓴다
SEARCH_PORT=8094

# 검색 색인 이름 앞의 환경 이름 (prod-products · prod-sellers)
SEARCH_INDEX_PREFIX=prod

# Gateway 가 상품 목록(GET /api/v1/products)을 넘길 곳(#526). 없으면 app 이 받는다
# 챗봇 상품 검색(#1191)도 이 주소의 내부 경로를 부른다
KIDLY_SEARCH_URI=http://search-service:8080

# Gateway 를 서버 127.0.0.1 에만 연다. nginx 의 운영 블록이 여기로 넘긴다 (dev 8083 · prod 8084)
GATEWAY_PORT=8084


# 추천 서비스(recommend-service, #704) 서버 포트. 127.0.0.1 에만 열고 Alloy 가 메트릭을 읽는다(밖에서는 Gateway 로만 닿는다)
# dev 는 8087 이고 prod 는 8086 이다
RECOMMEND_PORT=8086

# 정산 서비스(settlement-service, #729) 서버 포트. 127.0.0.1 에만 열고 Alloy 가 메트릭을 읽는다(밖에서는 Gateway 로만 닿는다)
# dev 는 8089 다. dev · prod 가 같은 서버라 양쪽에서 비어 있는 8095 를 쓴다(8090 · 8091 은 회원, 8092 · 8093 은 결제, 8094 는 검색)
SETTLEMENT_PORT=8095

# 관리자가 한 명도 없을 때 이 이메일과 Secret KIDLY_ADMIN_BOOTSTRAP_PASSWORD 로 첫 관리자를 만든다. 관리자가 생긴 뒤에는 무시된다
KIDLY_ADMIN_BOOTSTRAP_EMAIL=admin@kidly.kro.kr

# app 에 회원 · 인증 · 판매자 API 가 없어 회원 API 를 쓰는 환경은 모두 켠다. 이 값과 profile member 를 함께 지우면 안 된다
KIDLY_MEMBER_URI=http://member-service:8080
# 회원 서비스를 서버 127.0.0.1 에만 열어 Alloy 가 수집한다
MEMBER_PORT=8091

# 결제 서비스(payment-service, #525) 서버 포트. 127.0.0.1 에만 열고 Alloy 가 메트릭을 읽는다(밖에서는 Gateway 로만 닿는다)
# dev 는 8092 다. dev · prod 가 같은 서버라 겹치지 않게 8093 을 쓴다
PAYMENT_PORT=8093

# 상품 API(공개 · 판매자 · 관리자)를 받을 곳(#791). profile product도 켜져 있어야 한다. 줄을 지우면 app이 상품 API를 받는다
KIDLY_PRODUCT_URI=http://product-service:8080

# 상품 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, dev(8096)와 다른 번호여야 한다
PRODUCT_PORT=8097

# 주문 · 장바구니 · 배송 · 조르기 · 주문 관리자 API를 받을 곳(#826). profile order도 켜져 있어야 한다
# 챗봇 내 주문 조회(#1191)도 이 주소의 내부 경로를 부른다
KIDLY_ORDER_URI=http://order-service:8080

# 주문 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, dev(8100)와 다른 번호여야 한다
ORDER_PORT=8101

# 리뷰 · 찜 · 커뮤니티 관리자 API를 받을 곳(#827). profile community도 켜져 있어야 한다
KIDLY_COMMUNITY_URI=http://community-service:8080

# 커뮤니티 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, dev(8102)와 다른 번호여야 한다
COMMUNITY_PORT=8103

# 알림 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, dev(8098)와 다른 번호여야 한다
NOTIFICATION_PORT=8099

# 챗봇 API 를 받을 곳(#1191). profile chatbot 도 켜져 있어야 한다
KIDLY_CHATBOT_URI=http://chatbot-service:8080

# 챗봇 서비스의 서버 포트(127.0.0.1에만 연다). 모니터링 수집 대상으로 쓰며, compose 기본값(8104)과 다른 번호여야 한다
CHATBOT_PORT=8105

# Kafka exporter 전용 loopback 포트
KAFKA_EXPORTER_PORT=9309
