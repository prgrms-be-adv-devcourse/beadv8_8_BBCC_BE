# 비밀 값은 넣지 않는다. 비밀은 배포 때 GitHub Environment Secret 에서 이 파일 뒤에 붙는다
# (DB_PASSWORD(=POSTGRES_PASSWORD), KAKAO_CLIENT_SECRET, TOSS_SECRET_KEY, PAYMENT_KEY_ENCRYPTION_KEY. JWT 키는 jwt/ 에 파일로)
# DB_PASSWORD 를 바꾸면 DB 에서도 ALTER USER 로 바꿔야 한다 (POSTGRES_PASSWORD 는 볼륨을 처음 만들 때만 쓰인다)

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# postgres 는 compose 서비스 이름이다. localhost 가 아니다
DB_URL=jdbc:postgresql://postgres:5432/kidly
DB_USERNAME=kidly
POSTGRES_DB=kidly
POSTGRES_USER=kidly

# 서버의 jwt/ 가 컨테이너 /app/jwt 로 마운트된다
JWT_PUBLIC_KEY_LOCATION=file:/app/jwt/public.pem
JWT_PRIVATE_KEY_LOCATION=file:/app/jwt/private.pem

# 서버의 logs/ 가 컨테이너 /app/logs 로 마운트된다
LOG_PATH=/app/logs

# 카카오 REST API 키. 프론트에도 있는 공개 값이다
KAKAO_CLIENT_ID=ed51f791136691f72eb3b0e85272b98c
KAKAO_REDIRECT_URI=https://kidly.kro.kr/oauth/kakao/callback

CORS_ALLOWED_ORIGINS=https://kidly.kro.kr

APP_PORT=8080

# 임시: Flyway 도입 전까지 prod 도 엔티티 기준으로 스키마를 자동 갱신한다. Flyway 로 옮길 때 이 두 줄을 지운다
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_APPLICATION_JSON='{"spring.jpa.properties.hibernate.hbm2ddl.create_namespaces":"true"}'
