# 비밀 값은 넣지 않는다. 비밀은 배포 때 GitHub Environment Secret 에서 이 파일 뒤에 붙는다
# (DB_PASSWORD(=POSTGRES_PASSWORD), KAKAO_CLIENT_SECRET, TOSS_SECRET_KEY, PAYMENT_KEY_ENCRYPTION_KEY, MAIL_PASSWORD(선택), KIDLY_ADMIN_BOOTSTRAP_PASSWORD(선택). JWT 키는 jwt/ 에 파일로)
# DB_PASSWORD 를 바꾸면 DB 에서도 ALTER USER 로 바꿔야 한다 (POSTGRES_PASSWORD 는 볼륨을 처음 만들 때만 쓰인다)

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# postgres 는 compose 서비스 이름이다. localhost 가 아니다
DB_URL=jdbc:postgresql://postgres:5432/kidly
DB_USERNAME=kidly
POSTGRES_DB=kidly
POSTGRES_USER=kidly

# 서버의 jwt/ 가 컨테이너 /app/jwt 로 마운트된다
JWT_PUBLIC_KEY_LOCATION=file:/app/jwt/public.pem
JWT_PRIVATE_KEY_LOCATION=file:/app/jwt/private.pem

# 서버의 logs/ 가 컨테이너 /app/logs 로 마운트된다
LOG_PATH=/app/logs

# 카카오 REST API 키. 프론트에도 있는 공개 값이다
KAKAO_CLIENT_ID=ed51f791136691f72eb3b0e85272b98c
KAKAO_REDIRECT_URI=https://kidly.kro.kr/oauth/kakao/callback

CORS_ALLOWED_ORIGINS=https://kidly.kro.kr

APP_PORT=8080

# DB 를 서버 127.0.0.1 에만 연다. SSH 터널로 접속한다 (dev 5433 · prod 5434)
DB_PORT=5434

# 상품 이미지 S3 객체 key의 환경 경로 (prod/products/...)
PRODUCT_IMAGE_KEY_PREFIX=prod

# 알림 도메인 메일 발송 계정. 앱 비밀번호 MAIL_PASSWORD 는 Secret 에서 붙는다 (없으면 보내지 않고 로그만)
MAIL_USERNAME=programmers.bbcc.official@gmail.com

# 알림 메일 본문의 사이트 주소
NOTIFICATION_SITE_URL=https://kidly.kro.kr

# Gateway · 자녀 프로필(childprofile-service) · 추천 서비스를 띄운다 (docker-compose.yml 의 profile gateway · childprofile · recommend). 검색(search)은 prod 에 아직 없다
COMPOSE_PROFILES=gateway,childprofile,recommend

# Gateway 를 서버 127.0.0.1 에만 연다. nginx 의 운영 블록이 여기로 넘긴다 (dev 8083 · prod 8084)
GATEWAY_PORT=8084

# 자녀 프로필 서비스를 서버 127.0.0.1 에만 연다. 외부 비공개, 서버 안 수집(Alloy)용이다. dev(8085)와 같은 서버라 포트를 나눈다
CHILDPROFILE_PORT=8088

# 추천 서비스(recommend-service, #704) 서버 포트. 127.0.0.1 에만 열고 Alloy 가 메트릭을 읽는다(밖에서는 Gateway 로만 닿는다)
# dev 는 8087 이다. 자녀 프로필 서비스(8088)와 겹치지 않게 추천 몫으로 비워 둔 8086 을 쓴다
RECOMMEND_PORT=8086

# 관리자가 한 명도 없을 때 이 이메일과 Secret KIDLY_ADMIN_BOOTSTRAP_PASSWORD 로 첫 관리자를 만든다. 관리자가 생긴 뒤에는 무시된다
KIDLY_ADMIN_BOOTSTRAP_EMAIL=admin@kidly.kro.kr
