[Unit]
Description=Kidly local monitoring runbook summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/python3 /opt/app/monitoring/ai-summary/summary.py --state-dir /opt/app/monitoring/ai-summary-state --live
TimeoutStartSec=300
MemoryMax=96M
CPUQuota=25%
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/app/monitoring/ai-summary-state /opt/app/monitoring/operations
