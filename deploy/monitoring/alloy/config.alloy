// medium(k3s) 노드 자체의 메트릭과 이 노드 Pod 로그. DaemonSet 으로 뜬다 (k8s/alloy.yaml)
// 앱 서버(t3.large)의 앱 로그 · 앱 메트릭 · 호스트 메트릭은 deploy/monitoring-agent 의 Alloy 가 보낸다
// 호스트 경로는 k8s/alloy.yaml 이 /host 아래에 읽기 전용으로 마운트한다

prometheus.exporter.unix "node" {
    enable_collectors = ["textfile"]
    // The expected inventory lives on medium, independently of the app collector.
    textfile {
        directory = "/host/root/opt/app/monitoring/operations"
    }

	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"

	// Pod 마다 생기는 마운트(볼륨 · shm)는 빼서 Pod 를 새로 띄울 때마다 시계열이 늘지 않게 한다
	filesystem {
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/kubelet|var/lib/rancher)($|/)"
	}
}

// 앱 메트릭과 같은 15초 간격. job(integrations/unix) · instance(호스트 이름)는 기본값 그대로라 Kidly 서버 대시보드가 instance 로 서버를 고른다
prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	scrape_interval = "15s"
}

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://prometheus.monitoring.svc:9090/api/v1/write"
	}
}

// DaemonSet 이라 노드마다 자기 노드의 Pod 만 맡는다
discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

// Drilldown → Logs 가 service_name 으로 묶는다. 없으면 Loki 가 unknown_service 를 붙이므로 컨테이너 이름을 쓴다
discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "service_name"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.write.loki.receiver]
}

// 추천 서비스 Pod(namespace recommend-<환경>, #1028). t3.large 노드에 뜨지만 노드를 가리지 않고 여기서 모은다(large 에는 이 DaemonSet 이 없다)
// 메트릭은 Pod IP 로 바로 긁고(노드 사이 flannel 8472/udp), 로그는 API 서버로 읽는다(kubelet 10250/tcp)
// job · env · service_name 은 compose 때(monitoring-agent)와 같게 둬 대시보드 · 알림이 그대로 잡는다. instance 는 Pod 이름이다
discovery.kubernetes "recommend" {
	role = "pod"

	namespaces {
		names = ["recommend-dev", "recommend-prod"]
	}
}

discovery.relabel "recommend" {
	targets = discovery.kubernetes.recommend.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_phase"]
		regex         = "Running"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "http"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "recommend-(dev|prod)"
		target_label  = "env"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}
}

prometheus.scrape "kidly_recommend" {
	job_name        = "kidly-recommend"
	targets         = discovery.relabel.recommend.output
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.prometheus.receiver]
}

loki.source.kubernetes "recommend" {
	targets    = discovery.relabel.recommend.output
	forward_to = [loki.process.recommend.receiver]
}

// monitoring-agent 의 kidly_app 과 같은 처리. Pod 콘솔은 ECS JSON 한 줄이라 텍스트 줄 처리는 두지 않는다
loki.process "recommend" {
	stage.static_labels {
		values = {
			service_name = "kidly-recommend",
		}
	}

	stage.json {
		expressions = {
			level    = "log.level",
			traceId  = "",
			memberId = "",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	stage.structured_metadata {
		values = {
			traceId  = "",
			memberId = "",
		}
	}

	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}

// Collector health and delivery metrics; no application logs or IDs become labels.
prometheus.scrape "alloy_self" {
    targets = [{"__address__" = "127.0.0.1:12345", "collector" = "monitoring"}]
    job_name = "kidly-alloy"
    scrape_interval = "15s"
    forward_to = [prometheus.relabel.alloy_health.receiver]
}

prometheus.relabel "alloy_health" {
    forward_to = [prometheus.remote_write.prometheus.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|prometheus_remote_storage_(samples_pending|queue_highest_sent_timestamp_seconds|samples_failed_total|samples_dropped_total)|loki_write_(batch_retries_total|dropped_entries_total)"
        action = "keep"
    }
}

prometheus.scrape "storage_health" {
    targets = [
        {"__address__" = "prometheus.monitoring.svc:9090", "store" = "prometheus"},
        {"__address__" = "loki.monitoring.svc:3100", "store" = "loki"},
    ]
    job_name = "kidly-monitoring-store"
    scrape_interval = "30s"
    forward_to = [prometheus.relabel.storage_health.receiver]
}
prometheus.relabel "storage_health" {
    forward_to = [prometheus.remote_write.prometheus.receiver]
    rule {
        source_labels = ["__name__"]
        regex = "up|prometheus_tsdb_(wal_writes_failed_total|wal_truncations_failed_total|compactions_failed_total|head_truncations_failed_total)|loki_ingester_chunks_flush_failures_total"
        action = "keep"
    }
}
