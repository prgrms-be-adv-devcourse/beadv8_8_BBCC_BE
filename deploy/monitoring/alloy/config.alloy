// dev · prod 앱 컨테이너(compose 서비스 app · search-service) 로그를 Loki 로 보낸다
// env 라벨은 compose 프로젝트 이름(dev · prod), service_name 은 compose 서비스(app → kidly, search-service → kidly-search), level 라벨은 로그 줄에서 뽑는다
// 서버 콘솔은 ECS JSON 한 줄이다. 텍스트 줄은 JSON 이전 이미지가 남긴 것이라 전환 기간에만 쓰인다

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "kidly_app" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "app|search-service"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "dev|prod"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "env"
	}

	// Drilldown → Logs 가 서비스 이름으로 묶는다. 없으면 Loki 가 unknown_service 를 붙인다
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "app"
		target_label  = "service_name"
		replacement   = "kidly"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "search-service"
		target_label  = "service_name"
		replacement   = "kidly-search"
	}
}

loki.source.docker "kidly_app" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.kidly_app.output
	forward_to = [loki.process.kidly_app.receiver]
}

loki.process "kidly_app" {
	// 텍스트 줄의 스택 트레이스 여러 줄을 로그 한 건으로 묶는다 (로그 줄은 날짜 또는 JSON 의 { 로 시작한다)
	stage.multiline {
		firstline     = "^(\\d{4}-\\d{2}-\\d{2} |\\{)"
		max_wait_time = "3s"
	}

	// 예: {"@timestamp":"...","log":{"level":"ERROR",...},...,"traceId":"...","memberId":"7"}
	// traceId 는 요청 안에서만, memberId 는 로그인한 요청 안에서만 있다
	stage.json {
		expressions = {
			level    = "log.level",
			traceId  = "",
			memberId = "",
		}
	}

	// 예: 2026-10-16 17:33:04.385 ERROR [traceId] ... — 날짜로 시작하는 텍스트 줄에만 맞는다
	stage.regex {
		expression = "^\\d{4}-\\d{2}-\\d{2} \\S+\\s+(?P<level>[A-Z]+) "
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	// traceId · memberId 는 값 종류가 끝이 없어 라벨이 아니라 구조화 메타데이터로 둔다. {env="dev"} | traceId="..." 로 거른다
	stage.structured_metadata {
		values = {
			traceId  = "",
			memberId = "",
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}

// 호스트(EC2)와 컨테이너별 자원 사용량. 새 컨테이너 없이 Alloy 내장 exporter 로 모아 Prometheus 에 remote write 한다
// 호스트 경로는 docker-compose.yml 이 읽기 전용으로 마운트한다
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	rootfs_path = "/rootfs"
}

// 컨테이너는 name 라벨(dev-app-1 처럼 compose 프로젝트가 앞에 붙은 컨테이너 이름)로 구분한다. docker 라벨 · 환경 변수는 가져오지 않는다
prometheus.exporter.cadvisor "containers" {
	docker_only            = true
	store_container_labels = false
}

// 앱 메트릭(prometheus/prometheus.yml)과 같은 15초 간격
prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.remote_write.local.receiver]
	scrape_interval = "15s"
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	forward_to      = [prometheus.remote_write.local.receiver]
	scrape_interval = "15s"
}

prometheus.remote_write "local" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}
