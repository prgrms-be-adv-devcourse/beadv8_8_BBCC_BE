    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "운영 홈",
      "type": "link",
      "url": "/d/kidly-home",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "서비스 상태",
      "type": "link",
      "url": "/d/kidly-http?var-env=${env}&var-service=${service}&${__url_time_range}",
      "includeVars": false,
      "keepTime": false
    },
    {
      "title": "오류 로그",
      "type": "link",
      "url": "/d/kidly-logs?var-env=${env}&var-service=${service}&${__url_time_range}",
