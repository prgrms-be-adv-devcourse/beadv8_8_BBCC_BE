        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "kidly-gateway",
          "value": "kidly-gateway"
        }
      },
      {
        "name": "domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 2,
        "query": "label_values(kidly_app_expected{env=\"$env\",app_job=\"$service\"}, app_job)",
        "regex": "/kidly-(.*)/",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "수집 상태",
      "description": "정상이 아니면 Pod 재시작 여부와 아래 재시작 표시선, 같은 시간 로그를 확인합니다. 운영 중지는 의도한 중지입니다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "((max(last_over_time(up{env=\"$env\",job=\"$service\"}[1m])) + 1) and on() (max(kidly_app_expected{env=\"$env\",app_job=\"$service\"}) == 1)) or on() ((max(kidly_app_expected{env=\"$env\",app_job=\"$service\"}) == 1) * 0) or on() ((max(kidly_app_expected{env=\"$env\",app_job=\"$service\"}) == 0) * 0 - 1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
