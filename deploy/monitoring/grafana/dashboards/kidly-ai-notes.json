{
  "uid": "kidly-ai-notes",
  "title": "Kidly AI 운영 분석",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "tags": [
    "kidly",
    "ai-notes"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "서비스 상태 확인",
      "type": "link",
      "url": "/d/kidly-http",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "게시된 메모의 관측 경과 · 서비스 정상 여부 아님",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (max(kidly_ai_notes_last_observed_seconds{env=\"$env\"} and (time()-timestamp(kidly_ai_notes_last_observed_seconds{env=\"$env\"})<60)) > 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "게시 전 / 수집 확인 필요",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "게시 전 / 수집 확인 필요",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2400
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "미전송 메모 · 실패 시 AI 재호출하지 않음",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kidly_ai_notes_pending{env=\"$env\"} and (time()-timestamp(kidly_ai_notes_pending{env=\"$env\"})<60))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "게시 전 / 수집 확인 필요",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "게시 전 / 수집 확인 필요",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "최근 AI 분석 · 행을 펼쳐 관측·원인 후보·확인 순서·대응 보기",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "timeFrom": "14d",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"kidly-ai-notes\",env=\"$env\"} | json | line_format \"{{.headline}}\"",
          "queryType": "range",
          "maxLines": 1
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 4,
      "type": "text",
      "title": "읽는 방법",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "AI가 작성한 가설과 대응 제안입니다. 확정 진단이나 자동 복구가 아닙니다. 관측 시각·근거·누락된 정보와 게시 주체를 함께 확인하세요. 새 분석은 요청 시에만 게시하며, 예약 실행은 없습니다. 메모가 없거나 오래됐다는 이유로 정상으로 판단하지 마세요."
      }
    }
  ]
}
