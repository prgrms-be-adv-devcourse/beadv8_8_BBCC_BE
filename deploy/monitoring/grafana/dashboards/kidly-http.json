                    },
                    "2": {
                      "text": "중지 처리 중",
                      "color": "orange"
                    },
                    "3": {
                      "text": "기동 처리 중",
                      "color": "orange"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "horizontal",
            "textMode": "value",
            "colorMode": "value",
            "graphMode": "none"
          }
        },
        {
          "id": 12,
          "type": "stat",
          "title": "최근 수신 후 경과",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 27,
            "w": 12,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "expr": "time() - max by(job) (timestamp(up{env=\"$env\", job=~\"$service\"}))",
              "instant": true,
              "legendFormat": "{{job}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "horizontal",
            "textMode": "value_and_name",
            "colorMode": "value",
            "graphMode": "none",
            "text": {
              "titleSize": 12,
              "valueSize": 16
            }
          },
          "description": "마지막 up 샘플 이후 경과 시간입니다. 5분 이상 미수신이면 데이터가 없어질 수 있습니다. 중지 환경의 과거 데이터는 보관 기간 내 조회 가능합니다."
        },
        {
          "id": 1,
          "type": "stat",
