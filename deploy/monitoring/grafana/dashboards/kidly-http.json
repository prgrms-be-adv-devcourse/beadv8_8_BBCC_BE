          "expr": "topk(10, sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{env=\"$env\",job=~\"$service\",uri!~\"/actuator.*\",status=~\"4..\",job!=\"kidly-gateway\"}[$__range])) > 0) or topk(5, sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{env=\"$env\",job=~\"$service\",uri!~\"/actuator.*\",status=~\"4..\",job=\"kidly-gateway\"}[$__range])) > 0)"
