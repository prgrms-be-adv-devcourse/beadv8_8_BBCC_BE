              "fields": "",
              "values": false
            },
            "orientation": "horizontal",
            "textMode": "value_and_name",
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "text": {
              "titleSize": 12,
              "valueSize": 16
            }
