{
  "uid": "kidly-http",
  "title": "3 · Kidly 서비스 오류",
  "schemaVersion": 39,
  "tags": [
    "01 장애 확인",
    "kidly",
    "http"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "운영 : dev,prod : prod",
        "current": {
          "text": "운영",
          "value": "dev"
        },
        "options": [
          {
            "text": "운영",
            "value": "dev",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kidly_app_expected{env=\"$env\"}, app_job)",
        "refresh": 1,
        "includeAll": true,
        "allValue": "kidly-gateway|kidly-search|kidly-recommend|kidly-member|kidly-payment|kidly-product|kidly-order|kidly-community|kidly-chatbot|kidly-settlement",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 35,
      "type": "table",
      "title": "5xx가 난 API · 선택 기간",
      "description": "서버 오류가 난 경로입니다. 하위 서비스 상위 10개와 Gateway 상위 5개를 따로 뽑습니다. 줄을 누르면 그 서비스의 오류 로그가 열립니다.\n건수가 오르면 같은 시각의 ERROR 로그에서 예외 타입을 확인합니다. Gateway 줄은 하위 서비스 오류가 넘어온 것일 수 있습니다.\n비어 있으면 선택 기간에 5xx가 없었다는 뜻입니다(수집 끊김은 위 '서비스 수집 상태'로 판단).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "topk(10, sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{env=\"$env\",job=~\"$service\",uri!~\"/actuator.*\",status=~\"5..\",job!=\"kidly-gateway\"}[$__range])) > 0) or topk(5, sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{env=\"$env\",job=~\"$service\",uri!~\"/actuator.*\",status=~\"5..\",job=\"kidly-gateway\"}[$__range])) > 0)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "job": 0,
              "method": 1,
              "uri": 2,
              "status": 3,
              "Value": 4
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "links": [
            {
              "title": "이 서비스 오류 로그 열기",
              "url": "/d/kidly-logs?var-env=${env}&var-service=${__data.fields.job}&${__url_time_range}"
            }
          ],
          "noValue": "선택 기간에 해당 응답이 없습니다"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "서비스"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "method"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "메서드"
              },
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "상태"
              },
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "건수"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uri"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "경로"
              },
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 36,
      "type": "table",
      "title": "4xx가 많은 API · 선택 기간",
      "description": "요청 오류(400 · 401 · 403 · 404 · 409 등) 경로입니다. 하위 서비스 상위 10개와 Gateway 상위 5개를 따로 뽑습니다. 줄을 누르면 그 서비스의 오류 로그가 열립니다.\n특정 경로에서 갑자기 오르면 화면 요청 형식 · 인증 만료 · 배포 직후 API 변경을 확인합니다. 정상 흐름(로그인 만료 401 등)도 섞여 있습니다.",
      "gridPos": {
        "x": 12,
        "y": 0,
