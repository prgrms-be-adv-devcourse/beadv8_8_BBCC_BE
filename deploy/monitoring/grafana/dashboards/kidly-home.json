          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "수집 확인 필요",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "중지 설정",
                  "color": "gray"
                },
                "1": {
                  "text": "운영 대상",
                  "color": "blue"
                },
                "2": {
                  "text": "전환 중",
                  "color": "yellow"
                },
                "3": {
                  "text": "전환 중",
                  "color": "yellow"
                },
                "-1": {
                  "text": "수집 확인 필요",
                  "color": "gray"
                }
              }
            }
          ],
          "links": [
            {
              "title": "prod 서비스 상태 열기",
              "url": "/d/kidly-http?var-env=prod"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
