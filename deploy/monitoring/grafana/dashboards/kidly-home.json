  "panels": [
    {
      "id": 6,
      "type": "alertlist",
      "title": "지금 확인할 알림",
      "description": "발화 중인 알림과 평가 오류·데이터 누락을 최대 6개 표시합니다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "links": [
        {
          "title": "활성 알림 전체 보기",
          "url": "/alerting/groups"
        }
      ],
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 6,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "showInstances": true,
        "showInactiveAlerts": false,
        "stateFilter": {
          "firing": true,
          "pending": false,
          "recovering": false,
          "noData": true,
          "normal": false,
          "error": true
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "AI 분석 최신성",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((time() - (max(kidly_ai_notes_last_observed_seconds{env=\"dev\"} and (time()-timestamp(kidly_ai_notes_last_observed_seconds{env=\"dev\"})<60)) > 0)) >= bool 2400) + ((time() - (max(kidly_ai_notes_last_observed_seconds{env=\"dev\"} and (time()-timestamp(kidly_ai_notes_last_observed_seconds{env=\"dev\"})<60)) > 0)) >= bool 3600)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "분석 시각 확인 필요",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "최근 관측 · 현재 상태와 대조",
                  "color": "blue"
                },
                "1": {
                  "text": "갱신 권장",
                  "color": "yellow"
                },
                "2": {
                  "text": "과거 분석 · 현재 상태 확인",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          },
          "links": [
            {
              "title": "AI 분석·이력 열기",
              "url": "/d/kidly-ai-notes?var-env=dev&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "description": "마지막 게시 메모의 관측 시각 기준입니다. 현재 요청이나 장애 상태를 의미하지 않습니다. 40분부터 갱신 권장, 1시간부터 과거 분석으로 표시합니다."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "AI 관측 후 경과 · 정상 판정 아님",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (max(kidly_ai_notes_last_observed_seconds{env=\"dev\"} and (time()-timestamp(kidly_ai_notes_last_observed_seconds{env=\"dev\"})<60)) > 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "게시 전 / 수집 확인 필요",
