{
  "uid": "kidly-home",
  "title": "Kidly 운영 홈",
  "tags": [
    "kidly"
  ],
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "prod 운영 대상",
      "description": "환경 운영 설정과 전환 상태를 표시합니다. 서비스별 수집과 오류는 서비스 상태에서 확인하세요.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(kidly_environment_enabled{env=\"prod\"} and (time()-timestamp(kidly_environment_enabled{env=\"prod\"})<60)) + 2 * max(kidly_environment_transition_active{env=\"prod\"} and (time()-timestamp(kidly_environment_transition_active{env=\"prod\"})<60))) or vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "수집 확인 필요",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "중지 설정",
                  "color": "gray"
                },
                "1": {
                  "text": "운영 대상",
                  "color": "blue"
                },
                "2": {
                  "text": "전환 중",
                  "color": "yellow"
                },
                "3": {
                  "text": "전환 중",
                  "color": "yellow"
                },
                "-1": {
                  "text": "수집 확인 필요",
                  "color": "gray"
                }
              }
            }
          ],
          "links": [
            {
              "title": "prod 서비스 상태 열기",
              "url": "/d/kidly-http?var-env=prod"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
