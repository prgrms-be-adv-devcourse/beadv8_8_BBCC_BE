              "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"integrations/cadvisor\", instance=\"$instance\", name!=\"\"}[2m])) * 100",
              "legendFormat": "{{name}}"
            }
          ]
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "컨테이너 메모리",
          "description": "앱 서버의 컨테이너 working set입니다. 모니터링 서버는 cAdvisor를 수집하지 않아 이 패널이 비어 있습니다. 환경별 제한·실제 사용량을 함께 보고, 컨테이너별 최고값을 더해 호스트 동시 최고값으로 판단하지 마세요.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 30
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 15,
                "showPoints": "never",
                "gradientMode": "opacity"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "max by (name) (container_memory_working_set_bytes{job=\"integrations/cadvisor\",instance=\"$instance\",name!=\"\"} and (time() - timestamp(container_memory_working_set_bytes{job=\"integrations/cadvisor\",instance=\"$instance\",name!=\"\"}) < 30))",
              "legendFormat": "{{name}}"
            }
          ]
        },
        {
          "id": 21,
