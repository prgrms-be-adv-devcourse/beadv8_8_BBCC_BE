{
  "uid": "kidly-server",
  "title": "Kidly 서버",
  "tags": [
    "02 원인 조사",
    "kidly",
    "host"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "서버",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_uname_info{job=\"integrations/unix\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU 사용률",
      "description": "최근 2분 평균입니다. 단독 고사용률로 호출하지 않습니다. 지속되면 아래 상세를 펼쳐 어떤 컨테이너인지 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "데이터 없음",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (1 - avg(rate(node_cpu_seconds_total{job=\"integrations/unix\", instance=\"$instance\", mode=\"idle\"}[2m])))) and on () (max(time() - timestamp(node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"})) < 60)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "사용 가능 메모리",
      "description": "캐시 회수 가능량을 포함한 MemAvailable입니다. 10% 미만이 5분 지속되면 알립니다. 추가 기동을 보류하고 컨테이너 사용량을 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "데이터 없음",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * node_memory_MemAvailable_bytes{job=\"integrations/unix\", instance=\"$instance\"} / node_memory_MemTotal_bytes{job=\"integrations/unix\", instance=\"$instance\"}) and on () (max(time() - timestamp(node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"})) < 60)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "루트 디스크 사용률",
      "description": "80% 초과가 10분 지속되면 알립니다. 데이터·로그 보관량을 확인하세요. DB·Kafka 볼륨은 임의로 삭제하지 마세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "데이터 없음",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (1 - node_filesystem_avail_bytes{job=\"integrations/unix\", instance=\"$instance\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"integrations/unix\", instance=\"$instance\", mountpoint=\"/\"})) and on () (max(time() - timestamp(node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"})) < 60)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OOM(24h)",
      "description": "선택한 서버가 메모리 부족으로 프로세스를 종료한 횟수의 추정값입니다. 0이어도 수집 이전·수집 공백·재부팅 중 발생까지 부정하지 않습니다. 커널 기록과 컨테이너 OOMKilled를 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "데이터 없음",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(increase(node_vmstat_oom_kill{job=\"integrations/unix\", instance=\"$instance\"}[24h])) and on () (max(time() - timestamp(node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"})) < 60)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "서버·컨테이너 상세 (필요할 때 펼치기)",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [
        {
          "id": 11,
          "type": "stat",
          "title": "루트 inode 여유",
          "description": "파일을 새로 만들 수 있는 여유입니다. 여유 10% 미만이 10분 지속되면 알립니다. df -i /로 확인하고 작은 파일 급증 경로를 찾으세요.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 5,
            "w": 12,
            "x": 0,
            "y": 6
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "decimals": 1,
              "min": 0,
              "max": 100,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "green",
                    "value": 10
                  }
                ]
              },
              "color": {
                "mode": "thresholds"
              },
              "noValue": "데이터 없음",
              "mappings": [
                {
                  "type": "special",
                  "options": {
                    "match": "null",
                    "result": {
                      "text": "데이터 없음",
                      "color": "gray"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "graphMode": "none",
            "colorMode": "value",
            "textMode": "value",
            "justifyMode": "center"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "(100 * node_filesystem_files_free{job=\"integrations/unix\",instance=\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_files{job=\"integrations/unix\",instance=\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) and on () (max(time() - timestamp(node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"})) < 60)",
              "legendFormat": "",
              "instant": true
            }
          ]
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "CPU 사용률",
          "description": "최근 2분 평균",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
