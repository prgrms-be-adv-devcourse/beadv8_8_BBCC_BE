              },
              "expr": "sum(rate(node_disk_written_bytes_total{job=\"integrations/unix\", instance=\"$instance\"}[2m]))",
              "legendFormat": "쓰기"
            }
          ]
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "네트워크",
          "description": "물리 인터페이스(eth · en*) 합. 송신은 아래쪽으로 그린다",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 22
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "min": null,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 15,
                "showPoints": "never",
                "gradientMode": "opacity"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "송신"
                },
                "properties": [
                  {
                    "id": "custom.transform",
                    "value": "negative-Y"
                  }
                ]
