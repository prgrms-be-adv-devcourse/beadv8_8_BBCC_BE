              },
              "expr": "node_memory_MemAvailable_bytes{job=\"integrations/unix\",instance=\"$instance\"}",
              "legendFormat": "사용 가능"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "prometheus",
