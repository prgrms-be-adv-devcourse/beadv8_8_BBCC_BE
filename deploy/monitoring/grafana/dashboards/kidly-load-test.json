{
  "uid": "kidly-load-test",
  "title": "Kidly 부하 테스트",
  "description": "k6 부하 지표와 서버 지표를 같은 시간축으로 봅니다. 사용법: deploy/monitoring/docs/load-test-monitoring.md",
  "tags": [
    "kidly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "운영 홈",
      "type": "link",
      "url": "/d/kidly-home",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "서비스 상태",
      "type": "link",
      "url": "/d/kidly-http?var-env=dev&${__url_time_range}",
      "includeVars": false,
      "keepTime": false
    },
    {
      "title": "오류 로그",
      "type": "link",
      "url": "/d/kidly-logs?var-env=dev&${__url_time_range}",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "서비스 재시작",
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "max by (job, instance) ((time() - process_start_time_seconds{env=\"dev\",job=~\"$service\"}) < 90 >= 0)",
        "step": "60s",
        "titleFormat": "{{job}} 재시작",
        "textFormat": "{{instance}} · 부하 중 재시작이면 OOM · 헬스체크 실패 확인",
        "tagKeys": "job"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "테스트",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_vus, testid)",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kidly_app_expected{env=\"dev\"}, app_job)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "부하 요약 · 선택한 시간 범위",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "보낸 요청 수",
      "description": "k6가 보낸 HTTP 요청 수입니다(k6 누적 카운터의 마지막 값). 시간 범위가 테스트 끝을 포함해야 전체가 나옵니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(max_over_time(k6_http_reqs_total{testid=\"$testid\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "테스트를 고르세요",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "최대 가상 사용자",
      "description": "동시에 요청한 가상 사용자(VU) 최댓값입니다. 시나리오의 목표 VU와 다르면 k6 쪽 자원 · 스크립트 단계를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(max_over_time(k6_vus{testid=\"$testid\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "테스트를 고르세요",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "실패율",
      "description": "k6가 기대하지 않은 응답(기본: 4xx · 5xx · 연결 실패)의 비율입니다. 오르면 아래 서버 5xx · 오류 로그를 같은 시각으로 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(max_over_time(k6_http_reqs_total{testid=\"$testid\",expected_response=\"false\"}[$__range])) or vector(0)) / (sum(max_over_time(k6_http_reqs_total{testid=\"$testid\"}[$__range])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "테스트를 고르세요",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "가장 느린 API의 p95",
      "description": "성공한 요청 기준, API(name 태그)별 p95 중 가장 큰 값입니다. 테스트 시작부터 누적한 값입니다. 오르면 아래 서버 평균 응답 · DB 풀 대기를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(k6_http_req_duration_p95{testid=\"$testid\",expected_response=\"true\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "테스트를 고르세요",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "k6 · 부하를 준 쪽",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "초당 요청",
      "description": "k6가 보낸 초당 요청입니다. VU를 늘렸는데 더 오르지 않으면 서버가 한계에 가까운 것이니 아래 서버 응답시간 · CPU를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\"}[30s]))",
          "legendFormat": "전체"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\",expected_response=\"false\"}[30s]))",
          "legendFormat": "실패"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "응답 시간 · p95 · p99 · 평균",
      "description": "성공한 요청의 응답 시간입니다(k6가 잰 값, 테스트 시작부터 누적). 오르면 서버 평균 응답 · DB 풀 대기 · GC를 같은 시각으로 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(k6_http_req_duration_p95{testid=\"$testid\",expected_response=\"true\"})",
          "legendFormat": "p95 (가장 느린 API)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(k6_http_req_duration_p99{testid=\"$testid\",expected_response=\"true\"})",
          "legendFormat": "p99 (가장 느린 API)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "avg(k6_http_req_duration_avg{testid=\"$testid\",expected_response=\"true\"})",
          "legendFormat": "평균 (API 평균의 평균)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "가상 사용자 수",
      "description": "시나리오가 만든 동시 사용자 수입니다. 서버 지표가 나빠지기 시작한 VU가 이 서버의 버티는 한계입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(k6_vus{testid=\"$testid\"})",
          "legendFormat": "VU"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(k6_vus_max{testid=\"$testid\"})",
          "legendFormat": "VU 상한"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API별 p95",
      "description": "API(name 태그)별 p95입니다. 한 API만 오르면 그 API의 쿼리 · 외부 호출을 확인합니다. name 태그가 없으면 URL별로 나옵니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (name) (k6_http_req_duration_p95{testid=\"$testid\",expected_response=\"true\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "실패율 · 상태코드",
      "description": "실패율과 실패한 응답의 상태코드입니다. 5xx면 서버 오류 로그를, 4xx면 시나리오의 요청 · 인증을, 0이면 연결 실패(타임아웃)를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\",expected_response=\"false\"}[30s])) / (sum(rate(k6_http_reqs_total{testid=\"$testid\"}[30s])) > 0)",
          "legendFormat": "실패율"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (status) (rate(k6_http_reqs_total{testid=\"$testid\",expected_response=\"false\"}[30s]))",
          "legendFormat": "실패 · {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "check 성공률",
      "description": "시나리오의 check별 성공률입니다(테스트 시작부터 누적). 1 아래로 내려가면 응답 내용이 기대와 다른 것이니 그 check의 API 응답을 확인합니다.",
