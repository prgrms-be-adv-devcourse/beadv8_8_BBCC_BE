{
  "uid": "kidly-logs",
  "title": "Kidly 로그",
  "tags": [
    "kidly",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(env)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "상태 코드별 요청 수",
      "description": "요청 끝 로그(<<<)를 상태 코드별로 센다. actuator 정상 요청은 로그를 남기지 않아 빠진다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{http_response_status_code}}",
          "expr": "sum by (http_response_status_code) (count_over_time({env=\"$env\"} |= \"<<<\" | json | __error__=\"\" | http_response_status_code != \"\" [$__auto]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "요청 로그",
      "description": "method · path → status (duration) · traceId. 줄을 펼쳐 traceId 링크로 같은 요청의 로그를 본다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=\"$env\"} |= \"<<<\" | json | http_request_method != \"\" | line_format `{{.http_request_method}} {{.url_path}} → {{.http_response_status_code}} ({{.duration_ms}}ms) · {{.traceId}}`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "ERROR 로그",
      "description": "메시지 · 예외 타입. 스택 트레이스는 줄을 펼쳐 error_stack_trace 에서 본다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=\"$env\", level=\"ERROR\"} | json | line_format `{{ if .message }}{{ .message }}{{ if .error_type }} · {{ .error_type }}: {{ .error_message }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "느린 요청 (1초 넘음)",
      "description": "duration_ms > 1000 인 요청",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=\"$env\"} |= \"<<<\" | json | duration_ms > 1000 | line_format `{{.http_request_method}} {{.url_path}} → {{.http_response_status_code}} ({{.duration_ms}}ms) · {{.traceId}}`",
          "queryType": "range"
        }
      ]
    }
  ]
}
