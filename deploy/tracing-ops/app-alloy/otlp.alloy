// Dedicated collector for the opt-in operating trace trial.
otelcol.receiver.otlp "tracing_ops" {
  http {
    endpoint = sys.env("TRACING_OTLP_LISTEN")
  }

  output {
    traces = [otelcol.processor.memory_limiter.tracing_ops.input]
  }
}

otelcol.processor.memory_limiter "tracing_ops" {
  check_interval = "1s"
  limit = "384MiB"
  spike_limit = "64MiB"

  output {
    traces = [otelcol.processor.filter.tracing_ops.input]
  }
}

otelcol.processor.filter "tracing_ops" {
  error_mode = "propagate"

  traces {
    span = [
      `resource.attributes["deployment.environment.name"] != "dev"`,
      `resource.attributes["service.name"] == nil or not IsMatch(resource.attributes["service.name"], "` + sys.env("TRACING_ALLOWED_SERVICES") + `")`,
      `attributes["http.request.method"] == nil and attributes["http.method"] == nil and instrumentation_scope.name != "io.opentelemetry.jdbc" and instrumentation_scope.name != "io.opentelemetry.hibernate-6.0" and instrumentation_scope.name != "io.opentelemetry.spring-data-1.8" and not (resource.attributes["service.name"] == "kidly-search" and (attributes["db.system.name"] == "elasticsearch" or attributes["db.system"] == "elasticsearch"))`,
    ]
    spanevent = ["true"]
  }

  output {
    traces = [otelcol.processor.transform.tracing_ops.input]
  }
}

otelcol.processor.transform "tracing_ops" {
  error_mode = "propagate"

  trace_statements {
    context = "resource"
    statements = [`keep_keys(attributes, ["service.name", "deployment.environment.name"])`]
  }
  trace_statements {
    context = "span"
    statements = [
      `set(name, "HTTP")`,
      `set(name, "JDBC") where instrumentation_scope.name == "io.opentelemetry.jdbc"`,
      `set(name, "Hibernate") where instrumentation_scope.name == "io.opentelemetry.hibernate-6.0"`,
      `set(name, "Spring Data") where instrumentation_scope.name == "io.opentelemetry.spring-data-1.8"`,
      `set(name, "Elasticsearch") where resource.attributes["service.name"] == "kidly-search" and (attributes["db.system.name"] == "elasticsearch" or attributes["db.system"] == "elasticsearch")`,
      `set(status.message, "")`,
      `delete_key(attributes, "kidly.operation")`,
      `set(attributes["kidly.operation"], "order.detail") where resource.attributes["service.name"] == "kidly-order" and kind == SPAN_KIND_SERVER and (attributes["http.request.method"] == "GET" or attributes["http.method"] == "GET") and attributes["http.route"] == "/api/v1/orders/{orderId}"`,
      `keep_keys(attributes, ["http.response.status_code", "http.status_code", "kidly.operation"])`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.tracing_ops.input]
  }
}

otelcol.processor.batch "tracing_ops" {
  send_batch_size = 128
  send_batch_max_size = 256

  output {
    traces = [otelcol.exporter.otlphttp.tracing_ops.input]
  }
}

otelcol.exporter.otlphttp "tracing_ops" {
  client {
    endpoint = sys.env("TRACING_TEMPO_ENDPOINT")

    tls {
      ca_file   = "/etc/tracing-tls/ca.crt"
      cert_file = "/etc/tracing-tls/tls.crt"
      key_file  = "/etc/tracing-tls/tls.key"
    }
  }

  sending_queue {
    enabled = false
  }
}
